# /var/run/wan8021x.lock stays: rc.d/wan8021x callers may hold or wait for it during an upgrade,
# a new file under the same name would hand out a second lock
rm -rf /var/etc/wan8021x /var/etc/wan8021x.new /var/etc/wan8021x.old /var/run/wan8021x /etc/rc.conf.d/wan8021x
rm -rf /usr/local/opnsense/scripts/OPNsense/Wan8021x/__pycache__
