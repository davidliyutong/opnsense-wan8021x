#!/bin/sh
# ssh into the test VM as root: tools/bin/vm-ssh [command...]
root=$(cd "$(dirname "$0")/../.." && pwd)
. "$root/env/versions.env"
exec ssh -i "$root/.cache/ssh/id_ed25519" -p "${SSH_PORT:-12222}" \
	-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
	root@127.0.0.1 "$@"
